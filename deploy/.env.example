# SharePwd.io — Burn After Reading
# Zero-knowledge secret sharing. Client-side AES-256-GCM encryption, secrets self-destruct after viewing.
# Copyright (c) 2025-2026 Antonin HILY — CTO, Jizo AI

# PostgreSQL
POSTGRES_DB=sharepwd
POSTGRES_USER=sharepwd
POSTGRES_PASSWORD=changeme

# MinIO / S3
# Garage object store. Create the key with:
#   docker compose exec garage /garage key create sharepwd-backend
#   docker compose exec garage /garage bucket allow --read --write sharepwd --key sharepwd-backend
GARAGE_RPC_SECRET=generate-with-openssl-rand-hex-32
GARAGE_ADMIN_TOKEN=generate-with-openssl-rand-base64-32
GARAGE_ACCESS_KEY=changeme
GARAGE_SECRET_KEY=changeme
S3_BUCKET=sharepwd

# Backend
BASE_URL=https://sharepwd.io
CORS_ORIGINS=https://sharepwd.io
# Go duration. How long after a secret is burned its attached file stays
# available, so a reader can finish pulling the chunks. Raise it if you serve
# large files to readers on slow links.
GRACE_PERIOD=2m
MAX_TEXT_SIZE=102400
MAX_FILE_SIZE=104857600
CLEANUP_INTERVAL=60s

# Admin API (required for API key management)
# Generate with: openssl rand -base64 48
ADMIN_SECRET=changeme

# Frontend
NEXT_PUBLIC_API_URL=https://sharepwd.io
NEXT_PUBLIC_APP_URL=https://sharepwd.io

# Anti-bot defense layers
CHALLENGE_MIN_SOLVE_TIME=1500ms
CHALLENGE_TTL=5m
POW_DIFFICULTY=20
BEHAVIORAL_MIN_SCORE=30
ENV_MIN_SCORE=20
MAX_NONCES_PER_IP=3
METADATA_RATE_LIMIT=10
DEFENSE_STRICT_MODE=false

# Umami Analytics
UMAMI_DB_PASSWORD=changeme
UMAMI_APP_SECRET=changeme
# Set after creating a site in Umami dashboard
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
