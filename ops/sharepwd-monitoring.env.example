# SharePwd monitoring config — sourced by /usr/local/sbin/sharepwd-health.sh
# Install at /etc/sharepwd-monitoring.env with mode 0600.
# All values are optional; uncomment and set what you need.

# Recipient for the daily health email (default: root@localhost)
# RECIPIENT=ops@example.com

# Public IP of this server, displayed in the report header (default: hostname -I)
# SERVER_IP=

# Number of Docker containers expected by `docker compose ps` (default: 7 for the upstream stack)
# EXPECTED_CONTAINERS=7

# Docker compose project name, taken from the directory name where compose.yaml lives (default: deploy)
# DOCKER_COMPOSE_PROJECT=deploy

# Backend container name (default: ${DOCKER_COMPOSE_PROJECT}-backend-1)
# BACKEND_CONTAINER=deploy-backend-1

# Domain whose TLS certificate expiry is monitored (default: sharepwd.io)
# SSL_DOMAIN=sharepwd.io

# URL hit by the HTTP reachability check (default: https://${SSL_DOMAIN}/)
# HTTP_URL=https://sharepwd.io/

# RFC 5322 From: header for the daily report email (default: SharePwd Monitor <noreply@${SSL_DOMAIN}>)
# SENDER_FROM=SharePwd Monitor <noreply@example.com>

# Rocket.Chat incoming webhook URL — leave empty to disable the webhook channel
# ROCKET_WEBHOOK_URL=https://chat.example.com/hooks/AAA/BBB
